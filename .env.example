# ===== 数据库配置 =====
# 默认使用 SQLite：无需安装数据库，整个文件夹拷贝到其他电脑即可运行。
# 数据库文件位于 data/baijiao.db（首次运行会自动创建）。
#
# 如需切回 MySQL（课程要求口径），注释掉上面的 DB_URL，改用下面这行：
# DB_URL=mysql+pymysql://root:你的密码@127.0.0.1:3306/baijiao_aquaculture?charset=utf8mb4
#
# 留空表示使用默认的 SQLite
DB_URL=

# 以下四项仅在改用 MySQL 时生效（DB_URL 为空时被忽略）
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=baijiao_aquaculture

# ===== 服务配置 =====
APP_HOST=127.0.0.1
APP_PORT=5000
# 局域网演示时改成 0.0.0.0，手机连同一 WiFi 即可访问
# APP_HOST=0.0.0.0

# 调试模式（1=开发调试，Flask dev server + 热提示；默认 0=生产口径，用 waitress 多线程）
APP_DEBUG=0

# 调试（1 打开 SQL 回显）
DB_ECHO=0

# 大模型投喂建议：只在后端 .env 填写，禁止放进前端或小程序
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V4-Flash
